#!/usr/bin/env sh
# husky takes over core.hooksPath for this repo, which would bypass the
# global commit-msg hook installed at ~/.config/git/hooks. Delegate to it
# so co-author / generated-by footers keep getting stripped.
GLOBAL_HOOK="$HOME/.config/git/hooks/commit-msg"
if [ -f "$GLOBAL_HOOK" ]; then
  sh "$GLOBAL_HOOK" "$1"
  exit $?
fi
exit 0
